---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { pages } from '../../lib/sidebar';

export async function getStaticPaths() {
  const all = await pages();
  return all.map((page, i) => ({
    params: { slug: page.slug || undefined },
    props: { page, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { page, prev, next } = Astro.props;
const { Content } = await render(page.entry);
---

<DocsLayout page={page} prev={prev} next={next}>
  <Content />
</DocsLayout>
