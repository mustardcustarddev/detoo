---
/**
 * PostCard.astro — a post as a card, linking to it: its hero image, title,
 * date and description.  The home page and the blog both list posts this way.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../../lib/url';

interface Props {
  post: CollectionEntry<'blog'>;
  // The level of the title's heading, below the heading of the list.
  heading?: 'h2' | 'h3';
}

const { post, heading: Heading = 'h3' } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<a
  href={url(`blog/${post.id}/`)}
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--border)] transition-colors hover:border-[var(--color-primary-500)] hover:bg-[var(--bg-secondary)]"
>
  {
    post.data.heroImage && (
      <Image
        src={post.data.heroImage}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 768px) 310px, 100vw"
        class="aspect-video w-full object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <Heading class="font-semibold">{post.data.title}</Heading>
    <p class="mt-1 text-sm text-[var(--text-tertiary)]">
      <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
      {post.data.draft && <span class="ml-2 font-semibold">Draft</span>}
    </p>
    <p class="mt-2 text-sm text-[var(--text-secondary)]">{post.data.description}</p>
  </div>
</a>
