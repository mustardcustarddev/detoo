---
/**
 * Header.astro — the bar across the top of every page: the name, the two
 * halves of the site, the repository and the theme switch.  There are few
 * enough links that they fit on a phone, so there is no menu to open.
 */
import ThemeSelect from '../ui/ThemeSelect.tsx';
import { url } from '../../lib/url';
import { SITE } from '../../lib/site';

const here = Astro.url.pathname;
const links = [
  { label: 'Docs', href: url('docs/') },
  { label: 'Blog', href: url('blog/') },
];
---

<header class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur-lg">
  <div class="mx-auto flex h-14 max-w-[90rem] items-center justify-between gap-4 px-4 md:px-6">
    <a href={url()} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight">
      <img src={url('detoo-logo.png')} alt="" width="32" height="32" class="h-8 w-8 rounded-full" />
      <span>{SITE.name}</span>
    </a>

    <nav class="flex items-center gap-1" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={here.startsWith(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
              here.startsWith(link.href)
                ? 'bg-[var(--bg-secondary)] text-[var(--text-primary)]'
                : 'text-[var(--text-secondary)] hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={SITE.repo}
        class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-[var(--text-primary)]"
        aria-label="detoo on GitHub"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          ></path>
        </svg>
      </a>
      <ThemeSelect client:load />
    </nav>
  </div>
</header>
