---
/**
 * BaseLayout.astro — the document every page shares: metadata for search
 * engines and social cards, the theme, and slots for the header,
 * the content and the footer.
 */
import '../styles/global.css';

// Self-hosted, so no request leaves the site for a font.
import '@fontsource-variable/inter';

import { url, absolute } from '../lib/url';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  appendSiteName?: boolean;
}

const {
  title,
  description,
  image = 'og-default.png',
  canonicalUrl,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  appendSiteName = true,
} = Astro.props;

const currentUrl = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = /^https?:/.test(image) ? image : absolute(image, Astro.site);
const fullTitle = appendSiteName && title !== SITE.name ? `${title} | ${SITE.name}` : title;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={currentUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {author && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href={url('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <!--
      The theme is set before the page paints, so it never flashes light.  A
      light or dark choice is stored; with none, the page follows the system
      setting, and changes with it.
    -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Storage is blocked: follow the system setting.
        }
        root.dataset.theme = theme === 'light' || theme === 'dark' ? theme : 'system';
        function apply() {
          const chosen = root.dataset.theme;
          root.classList.toggle('dark', chosen === 'dark' || (chosen === 'system' && media.matches));
        }
        apply();
        media.addEventListener('change', apply);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[var(--bg)] text-[var(--text-primary)] antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-[var(--color-primary-600)] focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <slot name="header" />

    <div id="main-content">
      <slot />
    </div>

    <slot name="footer" />
  </body>
</html>
