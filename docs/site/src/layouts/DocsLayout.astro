---
/**
 * DocsLayout.astro — a page of the documentation: the contents on the left,
 * the page on the right.
 *
 * On a wide screen the contents stay in view while the page scrolls, and
 * scroll on their own if they are taller than the window.  On a narrow one
 * they fold away behind a "Contents" button above the page, which needs no
 * JavaScript.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import PrevNext from '../components/docs/PrevNext.astro';
import CopyPage from '../components/docs/CopyPage.astro';
import { sidebar, type Page } from '../lib/sidebar';
import { url } from '../lib/url';
import { markdownPath } from '../lib/markdown';
import { SITE } from '../lib/site';

interface Props {
  page: Page;
  prev?: Page;
  next?: Page;
}

const { page, prev, next } = Astro.props;
const { title, description } = page.entry.data;
const groups = await sidebar();

// Where to change what the page says: a hand-written page is its Markdown; a
// command's page is the tool's help, which the page is generated from.  The
// help of a command beneath another, such as "skills install", is skills-install.md.
const source =
  page.entry.collection === 'reference'
    ? `internal/${page.entry.data.tool}/help/${page.entry.data.command.replaceAll(' ', '-') || 'root'}.md`
    : `docs/site/${page.entry.filePath}`;

const crumbs = [{ label: 'Docs', href: url('docs/') }, ...(page.slug ? [{ label: page.group }, { label: title }] : [])];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <div class="mx-auto max-w-[90rem] px-4 md:px-6 lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-10">
    <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] overflow-y-auto border-r border-[var(--border)] py-8 pr-4 lg:block">
      <Sidebar groups={groups} current={page.href} label="Documentation" />
    </aside>

    <main class="min-w-0 py-8 lg:py-12">
      <details class="group mb-8 rounded-xl border border-[var(--border)] lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold">
          Contents
          <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"></path>
          </svg>
        </summary>
        <div class="border-t border-[var(--border)] px-1 py-4">
          <Sidebar groups={groups} current={page.href} label="Documentation contents" />
        </div>
      </details>

      <article class="max-w-3xl">
        <div class="flex items-start justify-between gap-4">
          <Breadcrumbs items={crumbs} />
          <CopyPage href={url(markdownPath(page.slug))} />
        </div>
        <h1
          class:list={[
            'mt-6 font-display text-3xl font-extrabold tracking-tight md:text-4xl',
            page.entry.collection === 'reference' && 'font-mono',
          ]}
        >
          {title}
        </h1>
        <p class="mt-3 text-lg text-[var(--text-secondary)]">{description}</p>

        <div class="prose mt-8 max-w-none dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-pre:text-[0.8rem] prose-pre:leading-relaxed">
          <slot />
        </div>

        <p class="mt-12 text-sm">
          <a class="text-[var(--text-tertiary)] hover:text-[var(--text-primary)] hover:underline" href={`${SITE.repo}/blob/main/${source}`}>
            Edit this page on GitHub
          </a>
        </p>

        <PrevNext prev={prev} next={next} />
      </article>
    </main>
  </div>

  <Footer slot="footer" />
</BaseLayout>
