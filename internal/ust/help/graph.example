  # Draw the user stories as an SVG image, with Mermaid:
  ust graph | mmdc -i - -o graph.svg

  # Draw them with Graphviz instead:
  ust graph --graphviz | dot -Tsvg > graph.svg

  # Draw a PDF with Graphviz, in which each story links to a .pdf file:
  ust graph --graphviz -e .pdf | dot -Tpdf > graph.pdf
