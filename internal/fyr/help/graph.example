  # Draw the fire drills as an SVG image, with Mermaid:
  fyr graph | mmdc -i - -o graph.svg

  # Draw them with Graphviz instead:
  fyr graph --graphviz | dot -Tsvg > graph.svg

  # Draw a PDF with Graphviz, in which each fire drill links to a .pdf file:
  fyr graph --graphviz -e .pdf | dot -Tpdf > graph.pdf
