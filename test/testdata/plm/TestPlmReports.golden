plm new "First Playbook"
docs/problem/PROBLEM-0001-first-playbook.md
plm new -r 1 "Second Playbook"
docs/problem/PROBLEM-0002-second-playbook.md
plm list --toc
# Problem Playbooks

* [1. First Playbook](PROBLEM-0001-first-playbook.md)
* [2. Second Playbook](PROBLEM-0002-second-playbook.md)
plm graph
flowchart TD
  plm1["1. First Playbook"]
  plm2["2. Second Playbook"]
  plm1 -.-> plm2
  plm2 -->|"Replaces"| plm1
  click plm1 "PROBLEM-0001-first-playbook.html"
  click plm2 "PROBLEM-0002-second-playbook.html"
plm graph --graphviz
digraph {
  node [shape=plaintext];
  subgraph {
    _1 [label="1. First Playbook"; URL="PROBLEM-0001-first-playbook.html"];
    _2 [label="2. Second Playbook"; URL="PROBLEM-0002-second-playbook.html"];
    _1 -> _2 [style="dotted", weight=1];
  }
  _2 -> _1 [label="Replaces", weight=0]
}
