rfc config
rfc_dir="docs/rfc"
rfc_template=""
rfc init
docs/rfc/RFC-0001-use-requests-for-comments.md
rfc config
rfc_dir="docs/rfc"
rfc_template=""
mkdir -p subdir
cd subdir
rfc config
rfc_dir="../docs/rfc"
rfc_template=""
cd ..
mkdir -p docs/rfc/templates
cat > docs/rfc/templates/template.md <<EOF
# NUMBER. TITLE

Date: DATE

## Status

STATUS

## Proposal
EOF
rfc config
rfc_dir="docs/rfc"
rfc_template="docs/rfc/templates/template.md"
cat > custom.md <<EOF
# NUMBER. TITLE, from custom.md

Date: DATE

## Status

STATUS

## Proposal
EOF
ADR_TEMPLATE=custom.md
ADR_DATE=2000-01-01
rfc new "Ignores the ADR settings"
docs/rfc/RFC-0002-ignores-the-adr-settings.md
RFC_TEMPLATE=custom.md
RFC_DATE=2026-09-10
rfc new "Uses the RFC settings"
docs/rfc/RFC-0003-uses-the-rfc-settings.md
cat docs/rfc/RFC-0002-ignores-the-adr-settings.md
# 2. Ignores the ADR settings

Date: 1992-01-12

## Status

Draft

## Proposal
cat docs/rfc/RFC-0003-uses-the-rfc-settings.md
# 3. Uses the RFC settings, from custom.md

Date: 2026-09-10

## Status

Draft

