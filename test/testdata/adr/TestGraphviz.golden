adr init
docs/adr/ADR-0001-record-architecture-decisions.md
adr new "An idea that seems good at the time"
docs/adr/ADR-0002-an-idea-that-seems-good-at-the-time.md
adr new -s 2 "A better idea"
docs/adr/ADR-0003-a-better-idea.md
adr new "This will work"
docs/adr/ADR-0004-this-will-work.md
adr new -s 3 "The end"
docs/adr/ADR-0005-the-end.md
adr link -u 5 4
adr graph --graphviz
digraph {
  node [shape=plaintext];
  subgraph {
    _1 [label="1. Record architecture decisions"; URL="ADR-0001-record-architecture-decisions.html"];
    _2 [label="2. An idea that seems good at the time"; URL="ADR-0002-an-idea-that-seems-good-at-the-time.html"];
    _1 -> _2 [style="dotted", weight=1];
    _3 [label="3. A better idea"; URL="ADR-0003-a-better-idea.html"];
    _2 -> _3 [style="dotted", weight=1];
    _4 [label="4. This will work"; URL="ADR-0004-this-will-work.html"];
    _3 -> _4 [style="dotted", weight=1];
    _5 [label="5. The end"; URL="ADR-0005-the-end.html"];
    _4 -> _5 [style="dotted", weight=1];
  }
  _3 -> _2 [label="Supersedes", weight=0]
  _5 -> _3 [label="Supersedes", weight=0]
  _5 -> _4 [label="Updates", weight=0]
}
