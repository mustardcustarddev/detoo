pse new "First Playbook"
docs/piosee/PIOSEE-0001-first-playbook.md
pse new -r 1 "Second Playbook"
docs/piosee/PIOSEE-0002-second-playbook.md
pse list --toc
# PIOSEE Playbooks

* [1. First Playbook](PIOSEE-0001-first-playbook.md)
* [2. Second Playbook](PIOSEE-0002-second-playbook.md)
pse graph
flowchart TD
  pse1["1. First Playbook"]
  pse2["2. Second Playbook"]
  pse1 -.-> pse2
  pse2 -->|"Replaces"| pse1
  click pse1 "PIOSEE-0001-first-playbook.html"
  click pse2 "PIOSEE-0002-second-playbook.html"
pse graph --graphviz
digraph {
  node [shape=plaintext];
  subgraph {
    _1 [label="1. First Playbook"; URL="PIOSEE-0001-first-playbook.html"];
    _2 [label="2. Second Playbook"; URL="PIOSEE-0002-second-playbook.html"];
    _1 -> _2 [style="dotted", weight=1];
  }
  _2 -> _1 [label="Replaces", weight=0]
}
